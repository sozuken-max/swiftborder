__pycache__/
*.pyc
.pytest_cache/
pytest-cache-files-*/
.venv/
.venv-*/
venv/
.coverage
.coverage.*
htmlcov/

# Local data extracts and logs
**/*.csv
# Figure series replayed from the cited eval run.json (not a data extract).
!eval/runs/replay-*/*/*.csv
# Plotted series of the published horizon-study charts (aggregates, not a data extract).
!docs/images/horizon-study/*.csv
**/*.log
# Test fixtures are small, hand-built, and must be committed
!**/tests/fixtures/**
Causeway/data/
# eval data caches and derived tables (only the README and .gitkeep are tracked)
eval/data/*
!eval/data/README.md
!eval/data/.gitkeep

# Secrets (Roboflow and Maps keys stay in the environment)
.env
.env.*
!.env.example

# Kilo Code agent worktrees and local setup (also listed in .git/info/exclude)
.kilo/worktrees/
.kilo/agent-manager.json
.kilo/setup-script
.kilo/setup-script.*
.kilocode/worktrees/
.kilocode/agent-manager.json
.kilocode/setup-script
.kilocode/setup-script.*

# Cursor local state. Project skills under .cursor/skills/ stay tracked.
.cursor/*
!.cursor/skills/
!.cursor/skills/**
